# ── Verilənlər bazası ────────────────────────────────────────────
# Lokal: `docker compose up -d db` → localhost:5432
DATABASE_URL=postgres://yolxeber:yolxeber@localhost:5432/yolxeber
POSTGRES_USER=yolxeber
POSTGRES_PASSWORD=yolxeber
POSTGRES_DB=yolxeber

# ── Gizli açarlar (hər biri ən azı 32 simvol) ────────────────────
# Yaratmaq üçün: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEVICE_SECRET=change-me-to-a-random-string-of-32-plus-chars
ADMIN_JWT_SECRET=change-me-to-another-random-string-32-plus

# ── Admin panel girişi (/admin/login) — production-da MÜTLƏQ dəyişin ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ── Etibarlılıq həddləri ─────────────────────────────────────────
CONFIRM_THRESHOLD=3      # "Mən də gördüm" sayı → Təsdiqlənib
OUTDATED_THRESHOLD=3     # "Artıq aktual deyil" sayı → arxiv
FLAG_THRESHOLD=3         # Şikayət sayı → avtomatik gizlədilir
REPORTS_PER_HOUR=20      # Bir cihazdan saatda maksimum bildiriş

# ── Media ────────────────────────────────────────────────────────
MEDIA_DIR=./data/media

# ── Reverse geocoding (Nominatim) ────────────────────────────────
# Nominatim qaydaları: tətbiqi tanıdan User-Agent (sayt və ya e-poçt). "example.com" yazılsa 403 qaytarır.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=YolXeber/1.0 (+https://yolxeber.tekerizm.com)

# ── Web push (VAPID) — yaratmaq: pnpm vapid ──────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Saytın ictimai ünvanı (paylaşma önizləmələri üçün)
SITE_URL=http://localhost:3000

# ── Production (docker compose --profile prod) ───────────────────
APP_PORT=3100            # app bu porta çıxır (serverdə 3000 və 9090 məşğuldur)
APP_BIND=0.0.0.0         # yalnız serverdəki reverse proxy arxasında olacaqsa: 127.0.0.1
DB_PORT=5432             # host-da PostGIS portu (yalnız 127.0.0.1); məşğuldursa dəyişin
# Yalnız öz Caddy-mizlə (--profile caddy) — 80/443 boş olduqda:
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

# ── Xəritə plitələri (istəyə bağlı) ─────────────────────────────
# Default: OpenStreetMap (tile.openstreetmap.org). OSM-in istifadə qaydası yüksək trafikə icazə vermir —
# production-da öz plitə serverinizi və ya provayderi (MapTiler, Stadia, Thunderforest və s.) qoşun.
# NEXT_PUBLIC_* dəyişənləri build zamanı koda yazılır — dəyişəndən sonra yenidən build edin.
NEXT_PUBLIC_TILE_URL=
NEXT_PUBLIC_TILE_URL_DARK=
NEXT_PUBLIC_TILE_ATTRIBUTION=

PROXY_NETWORK=app_default  # docker-compose.proxy.yml: mövcud nginx konteynerinin şəbəkəsi

# ── Statistika (Google Analytics 4) ──────────────────────────────
# Default: G-C53R01SXJH (kodda). Başqa axın üçün dəyişin, söndürmək üçün: off
# NEXT_PUBLIC_* build zamanı koda yazılır — dəyişəndən sonra yenidən build edin.
NEXT_PUBLIC_GA_ID=
