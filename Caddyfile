{$DOMAIN} {
	encode zstd gzip

	# Media faylları birbaşa volume-dan verilir (app-ə yük düşmür).
	# Fayl adları unikal olduğu üçün uzunmüddətli keş təhlükəsizdir.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}

	handle {
		reverse_proxy app:3000
	}
}
